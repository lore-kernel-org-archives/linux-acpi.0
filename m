#!/bin/bash

function die {
	echo -e "\aERROR:\n\t$1"
	exit 1
}
chvt 1
echo " * * * * * PREPARING TO SUSPEND * * * * *"

driver_check
modprobe dummydriver || die "modprobe dummydriver failed"
echo "-> dummydriver loaded"
echo "-> starting VESA X11 screen"

X -xf86config /etc/X11/XF86Config-4.vesa :2 &>/dev/null &
sleep 2
ps ax|grep X | grep " ${!}" &>/dev/null || die "Vesa X failed!"

echo "-> changing back to VT1"
chvt 1 || die "chvt failed"

#echo "-> dumping PCI data"
#/pcidat dump full >/dev/null

echo "-> syncing disks"
sync || die "sync failed!"

echo "* * * * * GOING DOWN * * * * *"
echo -n mem > /sys/power/state
echo "* * * * * COMING UP * * * * *"
echo "-> calling boot-vga-bios"
test -x /boot-vga-bios && /boot-vga-bios 
! test -x /boot-vga-bios && die "boot-vga-bios not found"

echo "-> changing to VT8"
chvt 8 &>/dev/null &
sleep 2

echo "-> changing to VT7"
chvt 7





