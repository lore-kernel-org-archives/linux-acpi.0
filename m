If we do hotplug quite many times, 'slot->number' might
overflow(but it's rare). To avoid this I removed the member
'slot->number' which is only used in get_lost_from_id().

Signed-off-by: MUNEDA Takahiro <muneda.takahiro@jp.fujitsu.com>

 drivers/pci/hotplug/acpiphp.h |    2 --
 1 files changed, 2 deletions(-)

Index: linux-2.6.16-rc1/drivers/pci/hotplug/acpiphp.h
===================================================================
--- linux-2.6.16-rc1.orig/drivers/pci/hotplug/acpiphp.h
+++ linux-2.6.16-rc1/drivers/pci/hotplug/acpiphp.h
@@ -59,7 +59,6 @@ struct acpiphp_slot;
  * struct slot - slot information for each *physical* slot
  */
 struct slot {
-	u8 number;
 	struct hotplug_slot	*hotplug_slot;
 	struct list_head	slot_list;
 
@@ -120,7 +119,6 @@ struct acpiphp_slot {
 					   objects (i.e. for each function) */
 	struct semaphore crit_sect;
 
-	u32		id;		/* slot id (serial #) for hotplug core */
 	u8		device;		/* pci device# */
 
 	u32		sun;		/* ACPI _SUN (slot unique number) */

