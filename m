--- linux-2.6.9/drivers/pci/pci-driver.c	2004-11-24 08:07:47.000000000 +0100
+++ linux-2.6.9-vgapost/drivers/pci/pci-driver.c	2004-11-26 07:27:14.000000000 +0100
@@ -329,13 +329,16 @@
 static void pci_default_resume(struct pci_dev *pci_dev)
 {
 	/* restore the PCI config space */
+	
 	pci_restore_state(pci_dev, pci_dev->saved_config_space);
+
+	
 	/* if the device was enabled before suspend, reenable */
 	if (pci_dev->is_enabled)
-		pci_enable_device(pci_dev);
-	/* if the device was busmaster before the suspend, make it busmaster again */
-	if (pci_dev->is_busmaster)
-		pci_set_master(pci_dev);
+		pci_enable_device(pci_dev); 
+	/*if the device was busmaster before the suspend, make it busmaster again*/
+	 if (pci_dev->is_busmaster)
+		pci_set_master(pci_dev); 
 }
 
 static int pci_device_resume(struct device * dev)
@@ -345,10 +348,18 @@
 
 	if (drv && drv->resume)
 		drv->resume(pci_dev);
-#ifndef CONFIG_OLD_PCI_RESUME		
-	else
-		pci_default_resume(pci_dev);
-#endif
+	else {
+        	 if ((pci_dev->class >> 16) != PCI_BASE_CLASS_DISPLAY)
+                	//acpi_vgapost(pci_dev->devfn); 
+			pci_default_resume(pci_dev);
+		else {
+			pci_restore_state(pci_dev, pci_dev->saved_config_space);
+			pci_enable_device(pci_dev); 
+			pci_set_master(pci_dev); 
+			//acpi_vgapost(pci_dev->devfn); 
+		}
+		
+	}
 	return 0;
 }
 

