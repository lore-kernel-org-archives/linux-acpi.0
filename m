--- linux-2.4.20-pre10-acpi1002/drivers/acpi/hardware/hwsleep.c.orig	Tue =
Oct  8 18:29:35 2002
+++ linux-2.4.20-pre10-acpi1002/drivers/acpi/hardware/hwsleep.c	Tue Oct  =
8 22:48:49 2002
@@ -309,6 +309,9 @@

        } while (!in_value);

+       /* Restore BM arbitration */
+       acpi_set_register(ACPI_BITREG_ARB_DISABLE, 0, ACPI_MTX_DO_NOT_LOC=
K);
+
        return_ACPI_STATUS (AE_OK);
 }

