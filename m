>From a013a2a001eb559a8e775060746786f142678db0 Mon Sep 17 00:00:00 2001
From: ISHIKAWA Mutsumi <ishikawa@hanzubon.jp>
Date: Fri, 17 Oct 2008 09:16:08 +0900
Subject: [PATCH] enable Sony NC driver on VGN-Z models

 Enable Sony NC driver on VAIO Z series

Signed-off-by: ISHIKAWA Mutsumi <ishikawa@hanzubon.jp>
---
 drivers/misc/sony-laptop.c |    9 +++++++++
 1 files changed, 9 insertions(+), 0 deletions(-)

diff --git a/drivers/misc/sony-laptop.c b/drivers/misc/sony-laptop.c
index 60775be..e40d491 100644
--- a/drivers/misc/sony-laptop.c
+++ b/drivers/misc/sony-laptop.c
@@ -889,6 +889,15 @@ static const struct dmi_system_id sony_nc_ids[] = {
 				DMI_MATCH(DMI_PRODUCT_NAME, "VGN-N"),
 			},
 		},
+		{
+			.ident = "Sony Vaio Z Series",
+			.callback = sony_nc_C_enable,
+			.driver_data = sony_C_events,
+			.matches = {
+				DMI_MATCH(DMI_SYS_VENDOR, "Sony Corporation"),
+				DMI_MATCH(DMI_PRODUCT_NAME, "VGN-Z"),
+			},
+		},
 		{ }
 };
 
