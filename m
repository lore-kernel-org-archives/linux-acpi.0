>=20
> <SNIP>
>=20
> >+static char*
> >+acpi_pcc_read_brightness(char* p)
> >+{
> >+	int i;
> >+
> >+	if (!acpi_pcc_retrive_biosdata())
> >+		return p;
> >+
> >+	for (i =3D 2; i < 8 ; i++) {
> >+		p +=3D sprintf(p, "%d",	sinf[i]);
