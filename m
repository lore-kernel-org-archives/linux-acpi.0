This patch removes cleanup_slots() calling from acpiphp_exit().
acpiphp un-registers hotplug slots with calling
acpiphp_unregister_hotplug_slot(), when the slot is going to be
removed.

Signed-off-by: MUNEDA Takahiro <muneda.takahiro@jp.fujitsu.com>

 drivers/pci/hotplug/acpiphp.h      |    1 +
 drivers/pci/hotplug/acpiphp_core.c |   13 ++++++++++---
 2 files changed, 11 insertions(+), 3 deletions(-)

Index: linux-2.6.16-rc1/drivers/pci/hotplug/acpiphp.h
===================================================================
--- linux-2.6.16-rc1.orig/drivers/pci/hotplug/acpiphp.h
+++ linux-2.6.16-rc1/drivers/pci/hotplug/acpiphp.h
@@ -202,6 +202,7 @@ struct acpiphp_attention_info
 extern int acpiphp_register_attention(struct acpiphp_attention_info*info);
 extern int acpiphp_unregister_attention(struct acpiphp_attention_info *info);
 extern int acpiphp_register_hotplug_slot(struct acpiphp_slot *slot);
+extern void acpiphp_unregister_hotplug_slot(struct acpiphp_slot *slot);
 
 /* acpiphp_glue.c */
 extern int acpiphp_glue_init (void);
Index: linux-2.6.16-rc1/drivers/pci/hotplug/acpiphp_core.c
===================================================================
--- linux-2.6.16-rc1.orig/drivers/pci/hotplug/acpiphp_core.c
+++ linux-2.6.16-rc1/drivers/pci/hotplug/acpiphp_core.c
@@ -404,16 +404,24 @@ error:
 }
 
 
-static void __exit cleanup_slots (void)
+void acpiphp_unregister_hotplug_slot(struct acpiphp_slot *acpiphp_slot)
 {
 	struct list_head *tmp, *n;
 	struct slot *slot;
+	int retval = 0;
 
 	list_for_each_safe (tmp, n, &slot_list) {
 		/* memory will be freed in release_slot callback */
 		slot = list_entry(tmp, struct slot, slot_list);
+		if (slot->acpi_slot->sun != acpiphp_slot->sun)
+			continue;
+
 		list_del(&slot->slot_list);
-		pci_hp_deregister(slot->hotplug_slot);
+		info ("Slot [%s] unregistered\n", slot->hotplug_slot->name);
+
+		retval = pci_hp_deregister(slot->hotplug_slot);
+		if (retval)
+			err("pci_hp_deregister failed with error %d\n", retval);
 	}
 }
 
@@ -435,7 +443,6 @@ static int __init acpiphp_init(void)
 
 static void __exit acpiphp_exit(void)
 {
-	cleanup_slots();
 	/* deallocate internal data structures etc. */
 	acpiphp_glue_exit();
 }

