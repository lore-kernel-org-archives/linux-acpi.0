#!/bin/bash
set -x

# Modules to unload/reload (do not use radeonfb!)
RELOAD=3D"psmouse mousedev acerhk"
# Subsystems to stop/start
RESTART=3D"hotplug powernowd gpm"


# Switch to console to reduce problems
/usr/bin/chvt 1

# Stopping subsystems
for S in $RESTART
do
	/etc/init.d/$S stop
done

# Unloading modules
for M in $RELOAD
do
=A0 =A0 =A0 =A0 if /bin/grep -q "^$M[[:blank:]]" /proc/modules
=A0 =A0 =A0 =A0 then
=A0 =A0 =A0 =A0 =A0 =A0 =A0 =A0 /sbin/modprobe -r "$M"
=A0 =A0 =A0 =A0 fi
done


# Zzzzz
sync
echo disk > /sys/power/state
#sync

# Reloading modules...
for M in $RELOAD
do
=A0 =A0 =A0 =A0 if /bin/grep -q "^$M[[:blank:]]" /proc/modules
=A0 =A0 =A0 =A0 then
=A0 =A0 =A0 =A0 =A0 =A0 =A0 =A0 /sbin/modprobe "$M"
=A0 =A0 =A0 =A0 fi
done


# Restarting subsystems...
for S in $RESTART
do
	/etc/init.d/$S start
done

