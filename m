> >+	if (sscanf(buffer, "%i,%i", &value1, &value2) =3D=3D 2 && value1 >=3D =
0 && value1 < 2 && value2 >=3D0 && value2 < 20) {
> >+		write_sset((value1 =3D=3D 1)?7:4, value2);
> >+	} else
> >+		printk("write_brightness error\n");
> >+
> >+	return count;
> >+}
